# Copia este archivo como .env y completa los valores. Nunca subas el .env al repositorio.
MONGO_URI=mongodb+srv://usuario:contraseña@cluster.mongodb.net/login_seguro
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
# Orígenes del frontend permitidos, separados por coma.
CORS_ORIGIN=http://localhost:5173
# Intentos fallidos de login permitidos por IP cada 15 minutos.
LOGIN_RATE_LIMIT=5
# Registros permitidos por IP cada hora.
REGISTER_RATE_LIMIT=10
# 1 cuando la API corre detrás de un proxy (Render, Nginx). Vacío en local.
TRUST_PROXY=
PORT=4000
